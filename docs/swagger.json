{
    "swagger": "2.0",
    "info": {
        "description": "Chat-based income/expense tracker powered by Ollama (local LLM).",
        "title": "Finance Chat API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/analytics": {
            "get": {
                "description": "Returns comprehensive analytics including monthly summary, category breakdown, spending patterns, and behavioral insights (AI analysis is mocked for now).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analytics"
                ],
                "summary": "Get analytics dashboard data",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.AnalyticsDashboard"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/chat": {
            "post": {
                "description": "Waits for the full LLM response, saves the transaction, and returns it.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chat"
                ],
                "summary": "Parse a natural language message (blocking)",
                "parameters": [
                    {
                        "description": "Message to parse",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.ChatRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/model.Transaction"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/chat/stream": {
            "post": {
                "description": "Streams LLM tokens as Server-Sent Events. Each token is sent as `event: token`.\nWhen the model finishes, the saved transaction is sent as `event: done` with JSON body.\nOn error, `event: error` is sent and the stream closes.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "chat"
                ],
                "summary": "Parse a natural language message (SSE streaming)",
                "parameters": [
                    {
                        "description": "Message to parse",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.ChatRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/corrections": {
            "get": {
                "description": "Returns all manual corrections made by the user. These corrections are used to train the AI.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "corrections"
                ],
                "summary": "List all user corrections",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.UserCorrection"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/corrections/{id}": {
            "delete": {
                "description": "Remove a correction by its ID. This will stop the AI from learning from this example.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "corrections"
                ],
                "summary": "Delete a user correction",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Correction ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/summary": {
            "get": {
                "description": "Returns total income, total expense, and current balance.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "Get financial summary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.Summary"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/transactions": {
            "get": {
                "description": "Returns all saved income and expense transactions, newest first.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "List all transactions",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.Transaction"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/transactions/{id}": {
            "get": {
                "description": "Returns a single transaction by ID with full details.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "Get transaction details",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Transaction ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Transaction"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Remove a transaction by its ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "Delete a transaction",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Transaction ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/transactions/{id}/correct": {
            "patch": {
                "description": "User can fix category, sub_category, brand or behavior_tag. Corrections are saved and fed back to the AI on future requests.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "Correct a transaction's classification",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Transaction ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to correct (only non-empty fields are applied)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.CorrectionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Transaction"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/webhook": {
            "post": {
                "description": "Receives events from Line and replies with AI-parsed transaction info. Always returns 200.\nTo correct the last transaction, send: edit brand=Starbucks sub=Coffee tag=treat",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook"
                ],
                "summary": "Line Messaging API webhook",
                "parameters": [
                    {
                        "description": "Line webhook payload",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/controller.LinePayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    },
    "definitions": {
        "controller.ChatRequest": {
            "type": "object",
            "required": [
                "message"
            ],
            "properties": {
                "message": {
                    "type": "string",
                    "example": "spent 250 baht on lunch"
                }
            }
        },
        "controller.CorrectionRequest": {
            "type": "object",
            "properties": {
                "behavior_tag": {
                    "type": "string",
                    "example": "treat"
                },
                "brand": {
                    "type": "string",
                    "example": "Starbucks"
                },
                "category": {
                    "type": "string",
                    "example": "Food \u0026 Drink"
                },
                "sub_category": {
                    "type": "string",
                    "example": "Coffee"
                }
            }
        },
        "controller.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "something went wrong"
                }
            }
        },
        "controller.LineEvent": {
            "type": "object",
            "properties": {
                "message": {
                    "$ref": "#/definitions/controller.LineMessage"
                },
                "replyToken": {
                    "type": "string",
                    "example": "nHuyWiB7yP5Zw52FIkcQobQuGDXCTA"
                },
                "source": {
                    "$ref": "#/definitions/controller.LineSource"
                },
                "type": {
                    "type": "string",
                    "example": "message"
                }
            }
        },
        "controller.LineMessage": {
            "type": "object",
            "properties": {
                "text": {
                    "type": "string",
                    "example": "spent 100 baht on coffee"
                },
                "type": {
                    "type": "string",
                    "example": "text"
                }
            }
        },
        "controller.LinePayload": {
            "type": "object",
            "properties": {
                "events": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.LineEvent"
                    }
                }
            }
        },
        "controller.LineSource": {
            "type": "object",
            "properties": {
                "userId": {
                    "type": "string"
                }
            }
        },
        "model.Transaction": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "behavior_tag": {
                    "description": "e.g. \"impulse\", \"necessity\", \"social\", \"treat\", \"recurring\"",
                    "type": "string"
                },
                "brand": {
                    "description": "e.g. Starbucks, Grab, McDonald's",
                    "type": "string"
                },
                "category": {
                    "description": "e.g. Food \u0026 Drink, Transport, Health",
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "raw_message": {
                    "type": "string"
                },
                "sub_category": {
                    "description": "e.g. Coffee, Taxi, Gym",
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/model.TransactionType"
                }
            }
        },
        "model.TransactionType": {
            "type": "string",
            "enum": [
                "income",
                "expense"
            ],
            "x-enum-varnames": [
                "Income",
                "Expense"
            ]
        },
        "model.UserCorrection": {
            "type": "object",
            "properties": {
                "behavior_tag": {
                    "type": "string"
                },
                "brand": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "raw_message": {
                    "description": "original message that was misclassified",
                    "type": "string"
                },
                "sub_category": {
                    "type": "string"
                }
            }
        },
        "service.Alert": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "type": {
                    "description": "\"warning\", \"info\", \"success\"",
                    "type": "string"
                }
            }
        },
        "service.AnalyticsDashboard": {
            "type": "object",
            "properties": {
                "behavior_insights": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.BehaviorInsight"
                    }
                },
                "category_breakdown": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.CategoryBreakdown"
                    }
                },
                "daily_spending": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.DailySpending"
                    }
                },
                "expense_comparison": {
                    "$ref": "#/definitions/service.ComparisonMetric"
                },
                "irregular_purchases": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.IrregularPurchase"
                    }
                },
                "monthly_summary": {
                    "$ref": "#/definitions/service.MonthlySummary"
                },
                "recent_highlights": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.HighlightedTransaction"
                    }
                },
                "savings_comparison": {
                    "$ref": "#/definitions/service.ComparisonMetric"
                },
                "spending_by_day_of_week": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.DayOfWeekSpending"
                    }
                }
            }
        },
        "service.BehaviorInsight": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "icon": {
                    "description": "emoji or icon name",
                    "type": "string"
                },
                "metric": {
                    "description": "e.g. \"3 times this week\"",
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "service.CategoryBreakdown": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "category": {
                    "type": "string"
                },
                "percentage": {
                    "type": "number"
                },
                "rank": {
                    "type": "integer"
                },
                "sub_category": {
                    "type": "string"
                }
            }
        },
        "service.ComparisonMetric": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "label": {
                    "description": "\"vs last month\", \"vs last week\"",
                    "type": "string"
                },
                "percentage": {
                    "description": "positive or negative",
                    "type": "number"
                }
            }
        },
        "service.DailySpending": {
            "type": "object",
            "properties": {
                "date": {
                    "description": "e.g. \"2025-04-01\"",
                    "type": "string"
                },
                "expense": {
                    "type": "number"
                },
                "income": {
                    "type": "number"
                }
            }
        },
        "service.DayOfWeekSpending": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "day": {
                    "description": "\"Mon\", \"Tue\", etc.",
                    "type": "string"
                }
            }
        },
        "service.HighlightedTransaction": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "category": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "highlight": {
                    "description": "\"most_spent\", \"unusual\", \"recurring\"",
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                }
            }
        },
        "service.IrregularPurchase": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "brand": {
                    "type": "string"
                },
                "date": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "reason": {
                    "description": "why it's irregular",
                    "type": "string"
                }
            }
        },
        "service.MonthlySummary": {
            "type": "object",
            "properties": {
                "alert": {
                    "$ref": "#/definitions/service.Alert"
                },
                "balance": {
                    "type": "number"
                },
                "month": {
                    "description": "e.g. \"April 2025\"",
                    "type": "string"
                },
                "total_expense": {
                    "type": "number"
                },
                "total_income": {
                    "type": "number"
                }
            }
        },
        "service.Summary": {
            "type": "object",
            "properties": {
                "balance": {
                    "type": "number"
                },
                "total_expense": {
                    "type": "number"
                },
                "total_income": {
                    "type": "number"
                }
            }
        }
    }
}