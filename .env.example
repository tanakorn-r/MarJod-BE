# Database — local SQLite (default)
DB_PATH=./finance.db

# Turso remote SQLite — set these for Cloud Run persistent storage
# Sign up free at https://turso.tech, then: turso db create finance-chat
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# Dedicated key used by GET /api/analytics for dashboard insights
OPENAI_API_KEY_INTERNAL=your_internal_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=http://localhost:5173,https://your-ngrok-url.ngrok-free.dev

# LINE Messaging API
LINE_CHANNEL_TOKEN=your_line_channel_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE LIFF — used to verify ID tokens sent by the LIFF frontend (Authorization: Bearer <id_token>)
LINE_LIFF_CHANNEL_ID=your_liff_channel_id_here

# Local dev only — NEVER set these in production.
# The frontend can set VITE_AUTH_DEV_BYPASS=true because LIFF login cannot
# complete on localhost. Mirror that here to bypass LINE token verification.
# When enabled, middleware uses ?user_id=<mock LINE user id> if present,
# otherwise AUTH_DEV_USER_ID.
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=default
